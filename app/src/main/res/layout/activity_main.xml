<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="USB Debugging"
            app:titleTextAppearance="?attr/textAppearanceHeadlineMedium" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:animateLayoutChanges="true">

            <!-- M3 Expressive Hero Card with Master Switch (One UI Style) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="28dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="14dp">

                    <!-- Main Row: Icon + Title/Subtitle + Master Switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Squircle Avatar -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardIconSquircle"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            app:cardCornerRadius="14dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest">

                            <ImageView
                                android:id="@+id/iconHeroAdb"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_qs_adb"
                                app:tint="?attr/colorOnSurfaceVariant"
                                android:contentDescription="ADB State Icon" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Title + Status Column -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="10dp">

                            <TextView
                                android:id="@+id/textHeroTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="USB Debugging"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/textHeroSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Off • Physical port is secure"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <!-- Pure Material 3 / One UI Switch -->
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchHeroAdb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbIcon="@null"
                            android:clickable="false"
                            android:focusable="false" />
                    </LinearLayout>

                    <!-- Integrated Readiness Sub-strip -->
                    <LinearLayout
                        android:id="@+id/layoutHeroSubstrip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp"
                        android:paddingTop="8dp">

                        <ImageView
                            android:id="@+id/iconHeroSubstrip"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="?attr/colorOnSurfaceVariant"
                            android:contentDescription="Readiness icon" />

                        <TextView
                            android:id="@+id/textHeroSubstrip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Tap switch or QS tile to enable debugging"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/textSectionStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Device Status &amp; Actions"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:fontFamily="sans-serif-black"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Subtle Pill Badge when All Ready -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/badgeAllReady"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="All Ready"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="?attr/colorOnPrimaryContainer" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- CARD 1: Tile Permission (Flat In-Card Flow) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermissionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="28dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                android:layout_marginBottom="10dp"
                android:animateLayoutChanges="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Status Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/iconPermission"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check_circle"
                            android:contentDescription="Permission" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tile Permission"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/textPermissionStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Checking..."
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/badgePermission"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

                            <TextView
                                android:id="@+id/textBadgePermission"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="Granted"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:fontFamily="sans-serif-black"
                                android:textColor="?attr/colorOnSurface" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Contextual Command (Concept 1: Flat In-Card Flow with Inset Hairline Divider) -->
                    <LinearLayout
                        android:id="@+id/layoutPermissionCommand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Inset Hairline Divider (Replaces the bulky nested card) -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutlineVariant"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="10dp" />

                        <!-- Subhead: Label + Action Required Badge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Grant Command (via PC)"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:fontFamily="sans-serif-black"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="8dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="?attr/colorErrorContainer">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="2dp"
                                    android:text="Action required"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:fontFamily="sans-serif-bold"
                                    android:textColor="?attr/colorOnErrorContainer" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <!-- Sleek Monospace Pill directly on card surface (8dp CornerSmall) -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="8dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:id="@+id/textCmdGrant"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="adb shell pm grant com.antigravity.usbdebugtile android.permission.WRITE_SECURE_SETTINGS"
                                android:fontFamily="monospace"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurface"
                                android:textIsSelectable="true" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Joined Tonal Action Pill [ Copy | Share | Help ] -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="end">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="20dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="?attr/colorSurfaceContainerHighest">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingHorizontal="4dp">

                                    <ImageView
                                        android:id="@+id/btnMainCopyGrant"
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:padding="6dp"
                                        android:src="@drawable/ic_content_copy"
                                        app:tint="?attr/colorOnSurfaceVariant"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        android:contentDescription="Copy command"
                                        android:clickable="true"
                                        android:focusable="true" />

                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="14dp"
                                        android:background="?attr/colorOutlineVariant"
                                        android:layout_marginHorizontal="2dp" />

                                    <ImageView
                                        android:id="@+id/btnMainShareGrant"
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:padding="6dp"
                                        android:src="@drawable/ic_share"
                                        app:tint="?attr/colorOnSurfaceVariant"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        android:contentDescription="Share to PC"
                                        android:clickable="true"
                                        android:focusable="true" />

                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="14dp"
                                        android:background="?attr/colorOutlineVariant"
                                        android:layout_marginHorizontal="2dp" />

                                    <ImageView
                                        android:id="@+id/btnMainHelpGrant"
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:padding="6dp"
                                        android:src="@drawable/ic_help_outline"
                                        app:tint="?attr/colorOnSurfaceVariant"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        android:contentDescription="Why is permission needed?"
                                        android:clickable="true"
                                        android:focusable="true" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 2: Samsung Auto Blocker (Flat In-Card Flow) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAutoBlockerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="28dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                android:layout_marginBottom="12dp"
                android:animateLayoutChanges="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Status Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/iconAutoBlocker"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check_circle"
                            android:contentDescription="Auto Blocker" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Samsung Auto Blocker"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/textAutoBlockerStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Checking..."
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/badgeAutoBlocker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

                            <TextView
                                android:id="@+id/textBadgeAutoBlocker"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="Off"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:fontFamily="sans-serif-black"
                                android:textColor="?attr/colorOnSurface" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Contextual Command (Concept 1: Flat In-Card Flow with Inset Hairline Divider) -->
                    <LinearLayout
                        android:id="@+id/layoutAutoBlockerCommand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Inset Hairline Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutlineVariant"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="10dp" />

                        <!-- Subhead: Label + Action Required Badge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Freeze Command (via PC)"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:fontFamily="sans-serif-black"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="8dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="?attr/colorErrorContainer">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="2dp"
                                    android:text="Action required"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:fontFamily="sans-serif-bold"
                                    android:textColor="?attr/colorOnErrorContainer" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <!-- Sleek Monospace Pill directly on card surface (8dp CornerSmall) -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="8dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:id="@+id/textCmdFreeze"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="adb shell pm disable-user --user 0 com.samsung.android.rampart"
                                android:fontFamily="monospace"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurface"
                                android:textIsSelectable="true" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Joined Tonal Action Pill [ Copy | Share | Help ] -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="end">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="20dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="?attr/colorSurfaceContainerHighest">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingHorizontal="4dp">

                                    <ImageView
                                        android:id="@+id/btnMainCopyFreeze"
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:padding="6dp"
                                        android:src="@drawable/ic_content_copy"
                                        app:tint="?attr/colorOnSurfaceVariant"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        android:contentDescription="Copy command"
                                        android:clickable="true"
                                        android:focusable="true" />

                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="14dp"
                                        android:background="?attr/colorOutlineVariant"
                                        android:layout_marginHorizontal="2dp" />

                                    <ImageView
                                        android:id="@+id/btnMainShareFreeze"
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:padding="6dp"
                                        android:src="@drawable/ic_share"
                                        app:tint="?attr/colorOnSurfaceVariant"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        android:contentDescription="Share to PC"
                                        android:clickable="true"
                                        android:focusable="true" />

                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="14dp"
                                        android:background="?attr/colorOutlineVariant"
                                        android:layout_marginHorizontal="2dp" />

                                    <ImageView
                                        android:id="@+id/btnMainHelpFreeze"
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:padding="6dp"
                                        android:src="@drawable/ic_help_outline"
                                        app:tint="?attr/colorOnSurfaceVariant"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        android:contentDescription="Why freeze Auto Blocker?"
                                        android:clickable="true"
                                        android:focusable="true" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 3: 1-Click Master Batch Export (Visible when any setup is pending) -->
            <LinearLayout
                android:id="@+id/layoutExportScriptSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <!-- M3 Expressive Split Button: [ 📥 Export 1-Click Setup Script (.bat) | ❓ ] -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardExportScriptSplit"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    app:cardCornerRadius="26dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="?attr/colorSecondaryContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Left Action: Export Script -->
                        <LinearLayout
                            android:id="@+id/btnMainExportScript"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="12dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_download"
                                app:tint="?attr/colorOnSecondaryContainer"
                                android:contentDescription="Export icon" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Export 1-Click Setup Script (.bat)"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="?attr/colorOnSecondaryContainer" />
                        </LinearLayout>

                        <!-- Hairline Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:background="?attr/colorOutlineVariant" />

                        <!-- Right Half-Button: Help -->
                        <FrameLayout
                            android:id="@+id/btnMainExportScriptHelp"
                            android:layout_width="52dp"
